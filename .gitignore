# ============================================
# .gitignore pro statický web (HTML / CSS / JS)
# ============================================

# --------------------------------------------
# macOS
# --------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd
.DocumentRevisions-V100
.TemporaryItems

# --------------------------------------------
# Windows
# --------------------------------------------
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# --------------------------------------------
# Linux
# --------------------------------------------
*~
.directory
.fuse_hidden*
.Trash-*
.nfs*

# --------------------------------------------
# JetBrains (WebStorm, PyCharm, IntelliJ...)
# --------------------------------------------
.idea/
*.iml
*.ipr
*.iws
out/

# --------------------------------------------
# Visual Studio Code
# --------------------------------------------
.vscode/
*.code-workspace
.history/

# --------------------------------------------
# Další editory
# --------------------------------------------
# Sublime Text
*.sublime-workspace
*.sublime-project

# Vim / Neovim
*.swp
*.swo
*.swn
Session.vim
.netrwhist

# Emacs
\#*\#
.\#*

# Zálohy a dočasné soubory
*.bak
*.backup
*.tmp
*.temp
*.orig
*.rej

# --------------------------------------------
# Node.js / npm / yarn / pnpm
# --------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm
.yarn/cache
.yarn/unplugged
.yarn/install-state.gz
.pnp.*
.eslintcache
.stylelintcache
*.tgz

# --------------------------------------------
# Výstup buildu a cache
# --------------------------------------------
dist/
build/
.cache/
.parcel-cache/
.temp/
.tmp/
.turbo/
.vite/
.next/
.nuxt/
.svelte-kit/
.astro/

# Statické generátory
_site/
.jekyll-cache/
.jekyll-metadata
.sass-cache/
public/build/
.docusaurus/

# --------------------------------------------
# Generované CSS / JS soubory
# --------------------------------------------
*.css.map
*.js.map
*.min.css.map
*.min.js.map

# --------------------------------------------
# Hosting (Vercel, Netlify, Cloudflare, Firebase...)
# --------------------------------------------
.vercel/
.netlify/
.wrangler/
.firebase/
.firebaserc
firebase-debug.log*
.serverless/

# --------------------------------------------
# Tajné a lokální soubory (nikdy nenahrávat!)
# --------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets.json
.htpasswd

# --------------------------------------------
# Testy a pokrytí
# --------------------------------------------
coverage/
.nyc_output/
playwright-report/
test-results/
cypress/videos/
cypress/screenshots/

# --------------------------------------------
# Logy
# --------------------------------------------
logs/
*.log

# --------------------------------------------
# Archivy a velké soubory (nepatří do repa)
# --------------------------------------------
*.zip
*.rar
*.7z
*.tar
*.gz
*.dmg
*.iso

# --------------------------------------------
# Ostatní
# --------------------------------------------
.sass-cache/
.grunt/
.gulp/
bower_components/
.terraform/